{
  "name": "@menuflow/control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:api": "wrangler dev worker/index.ts --port 8787 --persist-to .wrangler/state",
    "dev:api:lan": "node ../../scripts/serve-pos-lan.mjs",
    "db:migrate:local": "wrangler d1 migrations apply angkor-emenu --local --persist-to .wrangler/state",
    "build": "vite build && wrangler deploy worker/index.ts --dry-run --outdir dist-worker",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vite": "^6.1.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "latest",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.0.0"
  }
}

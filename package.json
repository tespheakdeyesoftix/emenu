{
  "name": "menuflow-saas",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:control": "npm run dev -w @menuflow/control",
    "dev:super": "npm run dev -w @menuflow/super-control",
    "dev:super-worker": "npm run dev:worker -w @menuflow/super-control",
    "dev:api": "npm run dev:api -w @menuflow/control",
    "dev:api:lan": "npm run dev:api:lan -w @menuflow/control",
    "db:migrate:local": "npm run db:migrate:local -w @menuflow/control",
    "dev:menu": "npm run dev -w @menuflow/menu",
    "dev:menu:lan": "npm run dev:lan -w @menuflow/menu",
    "dev:site": "npm run dev -w @menuflow/site",
    "build": "npm run build -w @menuflow/control && npm run build -w @menuflow/menu && npm run build -w @menuflow/site && npm run build -w @menuflow/super-control",
    "typecheck": "npm run typecheck -ws --if-present",
    "test:pos-sync": "node --test --test-concurrency=1 tests/pos-sync.test.mjs",
    "test:pos-api": "node --test --test-concurrency=1 tests/pos-api.test.mjs",
    "auth:setup": "node scripts/setup-auth-secret.mjs",
    "auth:reset-password": "node scripts/reset-password.mjs",
    "deploy:control": "node scripts/deploy-control.mjs",
    "deploy:menu": "node scripts/deploy-menu.mjs",
    "deploy:site": "node scripts/deploy-site.mjs",
    "deploy:all": "node scripts/deploy-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
